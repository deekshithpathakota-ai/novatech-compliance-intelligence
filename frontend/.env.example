# Backend origin used by the browser. This value is PUBLIC (bundled into the JS) — never put secrets in VITE_* variables.
#
# Local dev:  leave empty — the Vite dev proxy forwards /api -> http://localhost:8000
#             (override the proxy target with VITE_API_PROXY, e.g. VITE_API_PROXY=http://api:8000 in Docker Compose)
# Vercel:     set to your backend origin, no trailing slash needed, e.g. https://novatech-api.onrender.com
#             (a trailing "/" or "/api" is tolerated). Changing it requires a redeploy (Vite inlines it at build time).
VITE_API_URL=
