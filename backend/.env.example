# Copy to .env for local development. Never commit .env. On Render, set these in the service's Environment tab.

# ---- Core (required) ----
# Any of these formats works: postgresql+psycopg://…  postgresql://…  postgres://…  (normalised to psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/novatech
# development | demo | production. In production the API refuses to start with a placeholder/short JWT_SECRET.
ENVIRONMENT=development
# 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
# Comma-separated frontend origins (no wildcard; credentials are used). Trailing slashes are ignored.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for Vercel preview deployments, e.g. ^https://novatech-.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# ---- Startup ----
# true -> on boot, load the demo dataset ONLY if the database is empty (never wipes data)
SEED_DEMO_DATA=false
# Set to 1 to turn off the in-process scheduled compliance scan
DISABLE_SCHEDULER=
SESSION_TTL_MINUTES=480

# ---- Database pool (defaults suit a single small instance) ----
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=300

# ---- AI (optional — without these the deterministic engine runs every workflow) ----
OPENAI_API_KEY=
OPENAI_MODEL=            # reasoning-capable model for analysis & the Agents SDK loop
OPENAI_FAST_MODEL=       # optional cheaper model for intent classification
OPENAI_EMBEDDING_MODEL=  # used only when EMBEDDING_PROVIDER=openai
EMBEDDING_PROVIDER=hash  # hash (offline, pre-indexed demo) | openai
EMBEDDING_DIM=256        # must match the migration's vector dimension

# ---- Optional ----
REDIS_URL=
# Storage (S3-compatible in production; the prototype writes uploads to a local folder)
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
LOCAL_STORAGE_DIR=./storage

# ---- Demo pacing ----
DEMO_STEP_DELAY_MS=350
RATE_LIMIT_SCALE=1
